+static void broadcast_accel(struct k_work *work_item);
+K_WORK_DELAYABLE_DEFINE(accel_work, broadcast_accel);
+
+static void broadcast_accel(struct k_work *work_item)
+{
+    if (!streaming) {
+        return;
+    }
+    struct sensor_value a[3], g[3];
+    uint8_t packet[12];
+
+    if (sensor_sample_fetch(lsm6dsl_dev) == 0 && sensor_channel_get(lsm6dsl_dev, SENSOR_CHAN_ACCEL_XYZ, a) == 0 &&
+        sensor_channel_get(lsm6dsl_dev, SENSOR_CHAN_GYRO_XYZ, g) == 0) {
+        for (int i = 0; i < 3; i++) {
+            sys_put_le16((uint16_t) to_lsb(&a[i], ACCEL_LSB_MS2), &packet[2 * i]);
+            sys_put_le16((uint16_t) to_lsb(&g[i], GYRO_LSB_RADS), &packet[6 + 2 * i]);
+        }
+        /* NULL conn notifies every subscribed connection. */
+        int err = bt_gatt_notify(NULL, &accel_service.attrs[1], packet, sizeof(packet));
+        if (err && err != -ENOTCONN) {
+            LOG_DBG("accel notify (err %d)", err);
+        }
+    }
+    k_work_reschedule(&accel_work, K_MSEC(ACCEL_STREAM_INTERVAL_MS));
+}
 
